    "@fontsource-variable/readex-pro": "^5.3.0",
    "@fontsource-variable/reem-kufi": "^5.3.0",
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "@fontsource/aref-ruqaa": "^5.3.0",
    "@fontsource/gloock": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/lalezar": "^5.3.0",
    "@fontsource/rakkas": "^5.3.0",
    "@fontsource/tajawal": "^5.3.0",
    "@fontsource/young-serif": "^5.3.0",
    "dotenv": "^18.0.6",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "playwright": "^1.63.0",
    "tsx": "^4.23.15"
  },
  "engines": {
    "node": "22.x"
  }
}
