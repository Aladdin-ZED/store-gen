{
  "name": "cod-studio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build || next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit -p .",
    "fonts:sync": "node scripts/sync-fonts.mjs",
    "assets:build": "node scripts/build-landing-assets.mjs",
    "css:admin": "node scripts/build-admin-css.mjs",
    "predev": "node scripts/build-landing-assets.mjs && node scripts/build-admin-css.mjs",
    "prebuild": "npm run gate:offline && node scripts/build-landing-assets.mjs && node scripts/build-admin-css.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "pretypecheck": "node scripts/build-landing-assets.mjs",
    "theme:check": "tsx scripts/check-theme.ts",
    "pretest": "node scripts/build-landing-assets.mjs",
    "test": "npm run theme:check && npm run test:runtime && npm run test:generator && npm run test:render && npm run test:money && npm run test:conversions && npm run test:offers && npm run test:orders && npm run test:settings && npm run test:ownership && npm run test:tenancy-lint",
    "test:runtime": "tsx src/landing/runtime/selftest.ts",
    "test:generator": "tsx src/lib/generator/selftest.ts",
    "test:render": "tsx scripts/qa/render-check.ts",
    "test:money": "tsx scripts/qa/money-parity.ts",
    "test:turnstile": "tsx scripts/qa/turnstile-e2e.ts",
    "test:pixels": "tsx scripts/qa/pixels-e2e.ts",
    "test:conversions": "tsx scripts/qa/conversions-check.ts",
    "test:offers": "tsx scripts/qa/offers-check.ts",
    "test:pixels-publish": "tsx scripts/qa/pixels-publish-check.ts",
    "test:php": "tsx scripts/qa/php-parity.ts",
    "test:orders": "tsx src/lib/orders/selftest.ts",
    "qa:upgrade-dry-run": "tsx scripts/qa/upgrade-dry-run.ts",
    "test:tenancy-lint": "tsx scripts/qa/tenancy-lint.ts",
    "test:ownership": "tsx scripts/qa/ownership-check.ts",
    "test:hosts": "tsx src/lib/edge/selftest.ts",
    "test:permissions": "tsx src/lib/auth/selftest-permissions.ts",
    "test:tenancy-unit": "tsx src/lib/tenancy/selftest.ts",
    "test:settings": "tsx src/lib/settings/selftest.ts",
    "test:envelope": "tsx src/lib/security/selftest-envelope.ts",
    "test:security": "tsx src/lib/security/selftest.ts",
    "test:jobs": "tsx src/lib/jobs/selftest.ts",
    "test:prepublish": "tsx src/lib/render/selftest-prepublish.ts",
    "test:budget": "tsx scripts/qa/test-budget.ts",
    "test:slow": "npm run theme:check -- --full",
    "test:design:full": "tsx scripts/qa/design-check.ts --full",
    "test:ai:slow": "tsx src/lib/ai/selftest.ts --slow",
    "test:ai-eval": "tsx scripts/qa/ai-eval.ts",
    "test:migrate": "tsx scripts/qa/migrate-check.ts",
    "test:tenancy": "tsx scripts/qa/tenancy-check.ts",
    "test:public-api": "node --conditions=react-server --import tsx scripts/qa/public-api-security.ts",
    "test:store": "tsx src/lib/render/selftest-public.ts",
    "test:db": "npm run test:migrate && npm run test:tenancy && npm run qa:action-replay && npm run test:store && npm run test:pixels-publish && npm run test:public-api && npm run test:php",
    "qa:headers": "tsx scripts/qa/headers-check.ts",
    "qa:edge-sim": "tsx scripts/qa/edge-sim.ts",
    "qa:action-replay": "tsx scripts/qa/action-replay.ts",
    "qa:r1-exit": "tsx scripts/qa/e2e/r1.0-exit.ts",
    "test:e2e": "npm run qa:headers && npm run qa:edge-sim && npm run qa:r1-exit",
    "qa:secrets": "tsx --conditions=react-server scripts/qa/secrets-check.ts",
    "gate:offline": "npm run test:tenancy-lint && npm run test:ownership && npm run test:hosts && npm run test:permissions && npm run test:envelope && npm run test:security",
    "gate:tenancy": "npm run test:tenancy-lint && npm run test:tenancy-unit && npm run test:tenancy && npm run test:migrate && npm run qa:edge-sim && npm run qa:action-replay",
    "gate": "npm run typecheck && npm run lint && npm test && npm run test:slow && npm run test:db && npm run build && npm run test:e2e && npm run qa:secrets && tsx scripts/qa/gate-ok.ts",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.133.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@huggingface/transformers": "^4.3.1",
    "@huggingface/transformers-structured-output": "^4.3.1",
    "@tailwindcss/turbopack": "^4",
    "@types/culori": "^4.0.1",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "culori": "^4.0.2",
    "drizzle-orm": "^0.45.3",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.3",
    "immer": "^11.1.21",
    "input-otp": "^1.5.0",
    "libphonenumber-js": "^1.13.14",
    "lightningcss": "^1.33.0",
    "lucide-react": "^1.52.0",
    "motion": "^14.0.0",
    "mysql2": "^3.24.5",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-resizable-panels": "^4.14.2",
    "recharts": "^3.8.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.3",
    "sharp": "^0.35.5",
    "sonner": "^2.0.8",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "zod": "^4.6.6",
    "zundo": "^2.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@fontsource-variable/alexandria": "^5.3.0",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/baloo-bhaijaan-2": "^5.3.0",
