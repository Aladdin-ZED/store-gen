    "@fontsource-variable/big-shoulders-stencil-display": "^5.3.0",
    "@fontsource-variable/bodoni-moda": "^5.3.0",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/caveat": "^5.3.0",
    "@fontsource-variable/changa": "^5.3.0",
    "@fontsource-variable/dm-sans": "^5.3.0",
